# Secrets stay in this backend file; never in the frontend or Git.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PORTRAIT_MODEL=wan2.2-t2i-flash
IMAGE_UPLOAD_MODE=temporary
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional persistent random signing key (32+ chars). Empty uses data/.media-secret.
MEDIA_SIGNING_KEY=
# Dev login: requires development environment AND loopback client IP.
ENABLE_DEV_LOGIN=true
# Mini program (server-side code2session)
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# Official account: login inside WeChat H5 browser
WECHAT_H5_APPID=
WECHAT_H5_SECRET=
WECHAT_H5_REDIRECT_URI=
# Open platform website application: QR login in normal browsers
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=
WECHAT_WEB_REDIRECT_URI=
# Open platform mobile application: native App login
WECHAT_APP_APPID=
WECHAT_APP_SECRET=
# Request quotas, reset at midnight Asia/Shanghai; include failed/canceled requests.
DAILY_PORTRAIT_LIMIT=10
DAILY_TRYON_LIMIT=20
GLOBAL_DAILY_LIMIT=200
MAX_ASSETS_PER_USER=1000
MAX_ASSETS_TOTAL=10000

# Comma-separated application user IDs, never OpenIDs; local developer is admin only in development.
ADMIN_USER_IDS=
